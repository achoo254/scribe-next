# Cấu hình build web (PUBLIC — không phải secret; nhúng client bundle).
# Copy file này → web/.env (dùng cho cả dev local lẫn build prod) rồi điền giá trị thật:
# Firebase lấy từ Firebase Console (Project settings → Web app); origin backend là domain prod.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Origin backend mà app iPhone gọi (trang web thường dùng cùng origin nên không cần).
VITE_NATIVE_API_ORIGIN=https://your-backend.example.com
