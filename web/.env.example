# Cấu hình build web (PUBLIC — không phải secret; nhúng client bundle).
# Copy file này → web/.env (dùng cho cả dev local lẫn build prod) rồi điền giá trị thật.
# Origin backend mà app iPhone gọi (trang web dùng cùng origin nên không cần).
VITE_NATIVE_API_ORIGIN=https://scribe.hoandat.com
# Origin của hoandat-auth: link "Tài khoản hoandat" và "Ứng dụng" ở menu tài khoản
# và footer. Bỏ trống thì dùng https://auth.hoandat.com (mặc định ở src/lib/idp.ts).
VITE_IDP_ORIGIN=https://auth.hoandat.com
# Email hỗ trợ hiện ở mục "Liên hệ" của /privacy và /terms (App Store cần một cách liên hệ thật).
# Bỏ trống thì trang ghi "người vận hành Scribe qua tài khoản hoandat".
VITE_SUPPORT_EMAIL=
