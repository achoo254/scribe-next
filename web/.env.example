# Firebase web config (PUBLIC — không phải secret; nhúng client bundle).
# Copy file này → .env rồi điền apiKey lấy từ Firebase Console (Project settings → Web app)
# hoặc qua MCP firebase_get_sdk_config. authDomain/projectId dưới đây là giá trị thật của project.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=onescribe-inet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=onescribe-inet
