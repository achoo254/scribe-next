{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": [
		"check-tokens.ts",
		"check-tokens/**/*.ts",
		"brand-gen.ts",
		"brand-android.ts",
		"brand.test.ts",
		"theme-bootstrap.test.ts"
	]
}
