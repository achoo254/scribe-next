{
	"name": "scribe-web",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && pnpm run check:dist",
		"preview": "vite preview",
		"lint": "biome check . && pnpm run check:brand && pnpm run check:tokens",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts",
		"test:e2e:smoke": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts --project=chromium-desktop --grep @smoke",
		"test:e2e:csp": "node node_modules/@playwright/test/cli.js test --config e2e/csp/playwright.config.ts",
		"test:e2e:csp:smoke": "node node_modules/@playwright/test/cli.js test --config e2e/csp/playwright.config.ts --project=chromium-desktop --grep @smoke",
		"screenshots:app-store": "node node_modules/@playwright/test/cli.js test --config e2e/app-store/playwright.config.ts",
		"check:tokens": "tsx scripts/check-tokens.ts",
		"check:brand": "check-brand --config brand.config.json --dir src --dir scripts --dir e2e --file index.html --file vite.config.ts --file vite-brand.ts --file vitest.config.ts --file capacitor.config.ts --skip-dir test-results --skip-dir playwright-report --skip-dir check-brand --banned OneScribe --html-word --source-file '\\.(ts|tsx|js|mjs|cjs|json|html|css)$' --code-file '\\.(ts|tsx|js|mjs|cjs)$' --test-file '(^|/)(e2e|test)/|\\.(test|spec)\\.tsx?$' --hint 'read it from src/lib/brand.ts'",
		"brand:gen": "tsx scripts/brand-gen.ts",
		"check:dist": "tsx e2e/check-dist.ts",
		"ios:device": "scripts/ios-device.sh",
		"ios:release": "scripts/ios-release.sh",
		"ios:sync": "pnpm run build && cap sync ios",
		"android:device": "scripts/android-device.sh",
		"android:sync": "pnpm run build && cap sync android"
	},
	"dependencies": {
		"@achoo254/app-switcher": "github:achoo254/shared-next#v0.6.0&path:/packages/app-switcher",
		"@achoo254/brand": "github:achoo254/shared-next#v0.6.0&path:/packages/brand",
		"@capacitor/android": "8.5.3",
		"@capacitor/core": "8.5.3",
		"@capacitor/ios": "8.5.3",
		"@fontsource/inter": "^5.2.0",
		"@fontsource/jetbrains-mono": "^5.2.0",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-tabs": "1.1.22",
		"@radix-ui/react-toast": "^1.2.14",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tabler/icons-react": "^3.34.0",
		"@tanstack/react-query": "^5.104.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.6.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "1.9.4",
		"@capacitor/cli": "8.5.3",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^22.15.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"apca-w3": "^0.1.9",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.0",
		"vitest": "^3.2.4"
	}
}
