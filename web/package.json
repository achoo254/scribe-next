{
	"name": "scribe-web",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:tokens": "tsx scripts/check-tokens.ts",
		"ios:device": "scripts/ios-device.sh",
		"ios:sync": "npm run build && cap sync ios"
	},
	"dependencies": {
		"@capacitor/core": "8.5.3",
		"@capacitor/ios": "8.5.3",
		"@fontsource/inter": "^5.2.0",
		"@fontsource/jetbrains-mono": "^5.2.0",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-tabs": "1.1.22",
		"@radix-ui/react-toast": "^1.2.14",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tabler/icons-react": "^3.34.0",
		"@tanstack/react-query": "^5.104.1",
		"firebase": "^11.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@capacitor/cli": "8.5.3",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^22.15.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"apca-w3": "^0.1.9",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.0",
		"vitest": "^3.2.4"
	}
}
