{
	"name": "scribe-web",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && pnpm run check:dist",
		"preview": "vite preview",
		"lint": "biome check . && pnpm run check:brand && pnpm run check:tokens",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p brand/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts",
		"test:e2e:csp": "node node_modules/@playwright/test/cli.js test --config e2e/csp/playwright.config.ts",
		"screenshots:app-store": "node node_modules/@playwright/test/cli.js test --config e2e/app-store/playwright.config.ts",
		"check:tokens": "tsx scripts/check-tokens.ts",
		"check:brand": "tsx scripts/check-brand.ts",
		"brand:gen": "tsx brand/src/generate-cli.ts",
		"check:dist": "tsx e2e/check-dist.ts",
		"ios:device": "scripts/ios-device.sh",
		"ios:release": "scripts/ios-release.sh",
		"ios:sync": "pnpm run build && cap sync ios"
	},
	"dependencies": {
		"@capacitor/core": "8.5.3",
		"@capacitor/ios": "8.5.3",
		"@fontsource/inter": "^5.2.0",
		"@fontsource/jetbrains-mono": "^5.2.0",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-tabs": "1.1.22",
		"@radix-ui/react-toast": "^1.2.14",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tabler/icons-react": "^3.34.0",
		"@tanstack/react-query": "^5.104.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.6.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "1.9.4",
		"@capacitor/cli": "8.5.3",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^22.15.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"ajv": "8.20.0",
		"apca-w3": "^0.1.9",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.0",
		"vitest": "^3.2.4"
	}
}
