# Caddy (native, apt) — TLS auto-HTTPS cho web client + reverse proxy meeting-server + wss LiveKit.
# getUserMedia trên web BẮT BUỘC HTTPS → Caddy lo cert tự động (trừ localhost).
# Trên .65 hiện dùng nginx cho LiveKit wss (xem docs/deployment-guide.md §1.3); Caddyfile này cho
# môi trường Caddy-native (hoặc thay nginx). Chọn 1, KHÔNG chạy song song cùng cổng 443.

# API token + caption store.
api.tunnel.inetdev.io.vn {
	reverse_proxy 127.0.0.1:8787
}

# LiveKit signaling (wss). Media (UDP/TCP) đi TRỰC TIẾP tới server — KHÔNG qua Caddy.
livekit.tunnel.inetdev.io.vn {
	reverse_proxy 127.0.0.1:7880
}

# Web client tĩnh (apps/web build → dist). Thay đường dẫn root cho khớp deploy.
meet.tunnel.inetdev.io.vn {
	root * /var/www/onescribe-web
	encode gzip
	try_files {path} /index.html
	file_server
}
