# OneScribe meeting-server — biến môi trường. COPY sang .env (KHÔNG commit .env / secret thật).
# Chạy:  set -a; . ./.env; set +a; node index.mjs   (hoặc systemd EnvironmentFile)

# LiveKit API key/secret — KHỚP `keys:` trong livekit.yaml. Bắt buộc.
LK_API_KEY=devkey
LK_API_SECRET=please-change-to-a-long-random-secret

# URL wss cho client (trả kèm token cho tiện). Vd: wss://livekit.tunnel.inetdev.io.vn
LIVEKIT_URL=ws://localhost:7880

# Pre-shared secret cấp host-token (C6). Bắt buộc — chỉ người có secret này mới thành host.
HOST_SECRET=please-change-to-a-long-random-host-secret

# TURN (coturn) — để trống nếu chưa dựng TURN. static-auth-secret khớp coturn.
TURN_SECRET=
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_TTL_SEC=300

# Cổng service + TTL
PORT=8787
TOKEN_TTL_SEC=21600
CAPTION_TTL_SEC=86400

# CORS: * cho dev; production liệt kê domain web client, vd https://meet.tunnel.inetdev.io.vn
ALLOW_ORIGINS=*

# Tin X-Forwarded-For (rate-limit theo IP thật) CHỈ khi đứng sau reverse proxy tin cậy (nginx/Caddy).
# Mặc định false → dùng socket IP (chống bypass rate-limit bằng XFF giả → brute-force HOST_SECRET).
TRUST_PROXY=false

# (tùy chọn) key verify webhook LiveKit nếu khác LK_API_SECRET (phân tách bằng dấu phẩy)
# LK_WEBHOOK_KEYS=
